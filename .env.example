# Copy to .env and fill in. Never commit .env.
# Note: docker env files do not support comments after a value; keep comments on their own line.

# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register commands only in this server (instant updates while developing).
# Leave empty to register globally.
DEV_GUILD_ID=

# Max size of each input file, in MB
MAX_INPUT_MB=50
# Max size of a result, in MB. Must not exceed the Discord upload limit (10 MB; more on boosted servers)
MAX_OUTPUT_MB=10
MAX_PAGES=500
MAX_INPUTS_PER_JOB=10
MAX_CONCURRENT_JOBS=2
QUEUE_TIMEOUT_SECONDS=120
USER_COOLDOWN_SECONDS=5
DOWNLOAD_TIMEOUT_SECONDS=60

# Results are only visible to the user who ran the command unless they pass public:True
DEFAULT_EPHEMERAL=true

# Scratch directory (wiped per job, at start-up and at shutdown). In Docker this is RAM (tmpfs).
WORK_DIR=/tmp/discordpdf

# LibreOffice binary (auto-detected if empty)
SOFFICE_PATH=
OFFICE_TIMEOUT_SECONDS=180
# Optional sandbox wrapper for LibreOffice, for example: firejail --quiet --net=none
OFFICE_COMMAND_PREFIX=

# A TrueType (.ttf) CJK font for Markdown -> PDF, for example /fonts/NotoSansTC-Regular.ttf
FONT_CJK=

# Only while debugging: full stack traces may contain document text
LOG_ERROR_DETAILS=false

# JVM-wide DNS filter that refuses private / internal addresses (anti-SSRF). Keep enabled.
DISCORDPDF_DNS_GUARD=true
